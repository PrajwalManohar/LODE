# Copy to .env and fill in values
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional integrations — without these the prototype writes to local queues
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
RESEND_API_KEY=
RESEND_FROM=LODE <onboarding@resend.dev>
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
LAB_EMAIL_FROM=lode@mines.edu
LAB_EMAIL_TECH=labtech@mines.edu          # lab manager — primary HITL recipient
LAB_EMAIL_FACILITIES=facilities@mines.edu # CC'd on Email 3 (work order)
LAB_EMAIL_CHAIR=chair@mines.edu           # primary recipient of Email 4 (monthly)
# Demo: route all outgoing email to one inbox (Resend test mode). Clear in production.
EMAIL_OVERRIDE=

# --- Supabase (Phase 1+) --------------------------------------------------
# Project Settings → API. The backend uses the service-role key (server-only,
# never ship to the browser) and the JWT secret to verify request tokens.
# database_url is the pooled Postgres string used by the Phase 2 data layer.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=

# IANA timezone for the scheduler, emails, ICS files. Empty = auto-detect
# from the system clock (recommended). Examples: America/Denver,
# America/Indianapolis, America/Los_Angeles, Europe/London, Asia/Kolkata.
LODE_TZ=
