# ─── Secrets ───────────────────────────────────────────────────────────────
# Never commit real .env files — .env.example is the template.
CREDENTIALS_DEMO.md
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
*.pem
*.key
credentials.json
service-account*.json

# ─── LODE runtime artifacts (regenerated on every demo run) ────────────────
# The Postgres database is authoritative; everything below is scratch.
data/vein.db                # legacy SQLite (pre-Supabase)
data/chroma/                # ChromaDB index — bootstrap rebuilds on startup
data/airtable_queue/        # Local Airtable queue when no API key
data/email_outbox/          # Local email outbox when no transport configured
data/output/                # Generated SOPs (.docx) from booking confirms
data/_*.json                # Scratch JSON payloads written by debug scripts
data/*.sqlite*
data/*.bak

# Keep the *curated* corpus directories that ship with the repo:
!data/corpus/
!data/corpus/**/
!data/corpus/**/*.md
!data/corpus/**/*.pdf

# ─── Build outputs / temp ──────────────────────────────────────────────────
*.bak
*.tmp
*.swp
.tmp/
tmp/
.scratch/

# ─── Claude Code internals (kept local, not for sharing) ───────────────────
.claude/
