# ─── Secrets ───────────────────────────────────────────────────────────────
# Never commit real .env files — .env.example is the template.
CREDENTIALS_DEMO.md
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
*.pem
*.key
credentials.json
service-account*.json

# ─── LODE runtime artifacts (regenerated on every demo run) ────────────────
# The Postgres database is authoritative; everything below is scratch.
# NOTE: git does NOT support inline (trailing) comments in .gitignore — each
# comment must be on its own line, or the pattern silently stops matching.
# legacy SQLite (pre-Supabase)
data/vein.db
# ChromaDB index — bootstrap rebuilds on startup
data/chroma/
# Local Airtable queue when no API key
data/airtable_queue/
# Local email outbox when no transport configured
data/email_outbox/
# Generated SOPs (.docx) from booking confirms
data/output/
# Privacy audit log — runtime scratch, may contain researcher emails
data/audit/
# Scratch JSON payloads written by debug scripts
data/_*.json
data/*.sqlite*
data/*.bak

# Keep the *curated* corpus directories that ship with the repo:
!data/corpus/
!data/corpus/**/
!data/corpus/**/*.md
!data/corpus/**/*.pdf

# ─── Build outputs / temp ──────────────────────────────────────────────────
*.bak
*.tmp
*.swp
.tmp/
tmp/
.scratch/

# ─── Claude Code internals (kept local, not for sharing) ───────────────────
.claude/
